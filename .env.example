# Copy to .env and fill in values. Never commit the real .env.

# Required for all subcommands
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=

# Required for `geocode` subcommand (OAuth client credentials flow)
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# Required for `generate` subcommand (unless --dry-run)
AWS_REGION=us-east-1
S3_BUCKET=example-geofeed
S3_KEY=geofeed.csv

# AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional
AGGREGATE_COUNTRY=US
VERSIONED_MIRROR=false
RUST_LOG=info
